<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Railshot" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/ink</item>
    </style>

    <style name="Theme.Railshot.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.Railshot</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/ink</item>
    </style>
</resources>
